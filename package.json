  "scripts": {
    "build:frontend": "cd frontend && node ./node_modules/@angular/cli/bin/ng build --aot --configuration production --output-hashing=none --vendor-chunk=true --source-map=false",
    "build:server": "tsc -p tsconfig.build.json",
    "cypress:open": "cypress open",
    "frisby": "nyc --report-dir=./build/reports/coverage/api-tests jest --silent --runInBand --forceExit",
    "postinstall": "node scripts/remove-unused-benchmarks.js && npm ci --prefix frontend && npm run build:frontend && npm run build:server",
    "lint": "eslint *.[jt]s data lib models routes test views && cd frontend && ng lint && npx stylelint \"**/*.scss\" && cd ..",
    "lint:config": "schema validate -s config.schema.yml",
    "lint:fix": "eslint *.[jt]s data lib models routes test views rsn --fix && cd frontend && ng lint --fix && npx stylelint \"**/*.scss\" --fix && cd ..",
    "package": "grunt package",
    "package:ci": "npm prune --production && npm dedupe && cd frontend && npm prune --legacy-peer-deps --production && cd .. && grunt package",
    "serve": "concurrently --kill-others \"ts-node app.ts\" \"cd frontend && ng serve\"",
    "serve:dev": "concurrently --kill-others \"ts-node-dev app.ts\" \"cd frontend && ng serve\"",
    "start": "node build/app",
    "test": "npm run test:security",
    "test:all": "cd frontend && node ./node_modules/@angular/cli/bin/ng test --watch=false --source-map=true && cd .. && npm run test:server",
    "test:chromium": "cd frontend && ng test --watch=false --source-map=false --browsers=ChromiumHeadless && cd .. && npm run test:server",
    "test:server": "TS_NODE_PROJECT=tsconfig.test.json nyc --report-dir=./build/reports/coverage/server-tests mocha -r ts-node/register -r source-map-support/register --recursive test/server/**/*.ts",
    "rsn": "ts-node rsn/rsn.ts",
    "rsn:verbose": "ts-node rsn/rsn-verbose.ts",
    "rsn:update": "ts-node rsn/rsn-update.ts",
    "vagrant": "cd vagrant && vagrant up",
    "test:security": "TS_NODE_PROJECT=tsconfig.test.json mocha -r ts-node/register test/security/**/*.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "globals": {
      "ts-jest": {
        "diagnostics": false
      }
    },
    "globalSetup": "./test/apiTestsSetup.ts",
    "globalTeardown": "./test/apiTestsTeardown.ts",
    "modulePathIgnorePatterns": [
      "/build"
    ],
    "setupFilesAfterEnv": [
      "./test/apiTestsSetupJest.ts"
    ],
    "testMatch": [
      "<rootDir>/test/api/*Spec.[jt]s"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/frontend/node_modules/"
    ]
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "all": true,
    "include": [
      "lib/*.ts",
      "models/*.ts",
      "routes/*.ts",
      "server.ts"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
